# ============================================================
# FaceSim — environment config
# cp .env.example .env  then edit .env
# ============================================================

# ── Web demo ────────────────────────────────────────────────
# Password for the demo UI (REQUIRED — change before running)
DEMO_PASSWORD=change_this_password

# ── Segmentation device ─────────────────────────────────────
# cpu        → any machine, slow (~3-4 hours per scan)
# cuda       → NVIDIA GPU, fast (~10-15 min), recommended on server
# mps        → Apple Silicon (M1/M2), medium speed
SEGMENTATION_DEVICE=cpu

# ── Telegram notifications (optional) ───────────────────────
# Get token: message @BotFather → /newbot
# Get chat_id: message your bot, then:
#   curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Webhook notifications (optional, alternative to Telegram)
# Works with Slack, Discord, or any HTTP POST endpoint
NOTIFY_WEBHOOK=

# ── Phase 6: nnU-Net training paths (only needed for ML training)
# Set these before running: python pipeline/main.py --phase 6
# nnUNet_raw=/path/to/data/nnunet_raw
# nnUNet_preprocessed=/path/to/data/nnunet_preprocessed
# nnUNet_results=/path/to/data/nnunet_results
